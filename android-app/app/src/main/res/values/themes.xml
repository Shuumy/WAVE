<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WAVE" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/wave_black</item>
        <item name="android:statusBarColor">@color/wave_black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/wave_yellow</item>
        <item name="android:windowBackground">@color/wave_black</item>
    </style>

    <style name="Theme.WAVE.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wave_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_wave_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WAVE</item>
    </style>
</resources>
